# Backend Environment Configuration

PROJECT_NAME="IoT Smart Rack Inventory Management System"
VERSION="1.0.0"
ENVIRONMENT="production"

# PostgreSQL Connection String (in docker-compose: postgresql://smartrack:secret123@postgres:5432/smartrack_db)
# For local standalone dev: sqlite:///./smart_rack.db
DATABASE_URL="postgresql://smartrack:secret123@postgres:5432/smartrack_db"

# JWT Security
JWT_SECRET="smartrack_super_secure_jwt_secret_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IoT Hardware Security
DEVICE_API_KEY="SR-IOT-DEVICE-KEY-98421-ESP8266-A1"

# IoT Hardware Timeouts
RFID_DEBOUNCE_SECONDS=3.0
DEVICE_OFFLINE_TIMEOUT_SECONDS=60

# Critical Stock Fallback Threshold
CRITICAL_STOCK_DEFAULT=2
